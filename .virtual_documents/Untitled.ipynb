# 1. Take two numbers from user. Perform addition, subtraction, multiplication, division, floor
# division, modulus and exponent using operators.
num1 = float(input("enter the num"))
num2 = float(input("enter the seco number"))
print(f"addition of number{num1+num2}")
print(f"substraction of number{num1-num2}")
print(f"multiplication of number{num1*num2}")
print(f"division of number{num1/num2}")
print(f"floor divsion of number{num1//num2}")
print(f"exponent of number{num1**num2}")
print(f"modulus of number{num1%num2}")



# 2. Print all even numbers from 1 to 50 using for loop and skip numbers divisible by 10 using
# continue.
for i in range(1,51):
    if i%10==0:
        continue
    if i%2==0:
        print(i)


