# 5. Create a nested dictionary and perform shallow copy. Change a value in the inner
# dictionary and show the effect on original.
import copy

# Original nested dictionary
original = {
    "student": {
        "name": "Rohan",
        "age": 20
    },
    "course": "Python"
}

# Create a shallow copy
shallow = copy.copy(original)

# Change a value in the inner dictionary
shallow["student"]["age"] = 21

print("Original Dictionary:", original)
print("Shallow Copy:", shallow)


